DATABASE_URL="postgresql://USER@localhost:5432/khalkospay?schema=public"
PORT=3101
# Comma-separated origins allowed to call the API and open voice calls. Empty = allow all (dev only).
CORS_ORIGINS=

# Nimiq: "mainnet" or "testnet". Testnet needs your own NIMIQ_RPC_URL (no public testnet RPC is reliable).
NIMIQ_NETWORK=mainnet
NIMIQ_RPC_URL=https://rpc.nimiqwatch.com
# Treasury that receives off-ramp deposits. With the private key set, failed payouts are refunded automatically.
# Generate one with: npm run treasury:new
NIMIQ_TREASURY_PRIVATE_KEY=
# Receive-only alternative when you don't want the key on this server (refunds become manual).
NIMIQ_TREASURY_ADDRESS=
NIMIQ_MIN_CONFIRMATIONS=10

# Paystack secret key. Disable transfer OTP in the Paystack dashboard so payouts can run automatically.
# Webhook URL to set in Paystack: https://YOUR_HOST/api/webhooks/paystack
PAYSTACK_SECRET_KEY=sk_test_xxx

OFFRAMP_FEE_BPS=100
OFFRAMP_MIN_PAYOUT_NGN=100
OFFRAMP_MAX_PAYOUT_NGN=500000
OFFRAMP_QUOTE_TTL_SECONDS=600
# Optional: pin the NIM/NGN rate for local testing instead of the live CoinGecko price.
RATE_OVERRIDE_NGN_PER_NIM=
COINGECKO_API_KEY=

# Deepgram Voice Agent (speech-to-text, Claude reasoning and text-to-speech for live calls)
DEEPGRAM_API_KEY=
# Anthropic key for BiteBuddy meal analysis
ANTHROPIC_API_KEY=

# Public host of the mini app (no https://), e.g. khalkospay.app. Gift emails link to
# https://nimpay.app/miniapps/open/<MINIAPP_URL>/gift/<id>, which opens the gift inside Nimiq Pay.
MINIAPP_URL=
# Resend (resend.com) sends recipients the gift link once a gift is funded. RESEND_FROM must use a
# domain verified in Resend, e.g. "KhalkosPay <gifts@yourdomain.com>". The test sender
# onboarding@resend.dev only delivers to your own Resend account email.
RESEND_API_KEY=
RESEND_FROM=
# Signs wallet sign-in sessions. Defaults to a key derived from the treasury key.
AUTH_SECRET=

# Buy NIM with local currency through Bachs (bachs.io) hosted checkout. sk_sandbox_ keys use the sandbox,
# sk_live_ keys production. Add a webhook endpoint https://YOUR_HOST/api/webhooks/bachs (events:
# collection.succeeded, collection.underpaid, checkout.completed, checkout.expired) and paste its signing secret below.
# Without the secret, payments are still picked up by polling every ~20 seconds.
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
# Fee kept on each purchase (200 = 2%), per-purchase limits in USD, and how long a quote/checkout stays open.
ONRAMP_FEE_BPS=200
ONRAMP_MIN_USD=1
ONRAMP_MAX_USD=500
ONRAMP_CHECKOUT_TTL_MINUTES=30
# NIM always kept back from sale, beyond what the treasury already owes to gifts, refunds and cash-outs.
ONRAMP_RESERVE_NIM=0

# Admin dashboard at /admin (stats, activity for every feature, settling Buy NIM purchases held for review).
# Create or reset the login with: npm run admin:seed  (also runs as the Prisma seed). It only writes to a database on
# localhost unless you pass --allow-remote. Leave ADMIN_PASSWORD empty to have the seed generate and print one.
# Passwords are stored as scrypt hashes; sign-ins last ADMIN_SESSION_HOURS.
ADMIN_EMAIL=admin@khalkospay.local
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_SESSION_HOURS=12

# Static token for scripts calling /api/admin without signing in, as "Authorization: Bearer <ADMIN_TOKEN>".
# Leave empty to keep it off (the dashboard sign-in works either way). Use at least 32 random characters,
# e.g. from: openssl rand -hex 32
#   GET  /api/admin/onramp?status=NEEDS_REVIEW
#   POST /api/admin/onramp/<id>/settle  {"action":"send","mode":"full"|"pro-rata","note":"..."}
#                                       {"action":"close","note":"Refunded via Bachs","refundRef":"optional id"}
ADMIN_TOKEN=
