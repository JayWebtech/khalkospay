    "db:studio": "prisma studio",
    "treasury:new": "tsx src/scripts/new-treasury.ts",
    "admin:seed": "tsx src/scripts/seed-admin.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx src/scripts/seed-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@nimiq/core": "^2.22.0",
    "@prisma/client": "^6.1.0",
