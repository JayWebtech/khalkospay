generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OfframpStatus {
  AWAITING_DEPOSIT
  CONFIRMING
  PAYING_OUT
  COMPLETED
  PAYOUT_FAILED
  REFUNDING
  REFUNDED
  REJECTED
  EXPIRED
}

enum GiftCardStatus {
  AWAITING_FUNDING
  ACTIVE
  CLAIMING
  CLAIMED
  EXPIRED
  REFUNDING
  REFUNDED
}

enum PetStatus {
  ALIVE
  DEAD
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
}

enum PetRevivalStatus {
  AWAITING_PAYMENT
  PAID
  EXPIRED
  REFUNDING
  REFUNDED
}

enum OnrampStatus {
  AWAITING_PAYMENT
  PAID
  SENDING
  COMPLETED
  EXPIRED
  NEEDS_REVIEW
  /// An operator closed a held purchase after refunding the buyer outside KhalkosPay; no NIM is owed.
  RESOLVED
}

enum LedgerKind {
  DEPOSIT
  PAYOUT
  REFUND
}

enum MerchantPaymentStatus {
  /// Created when the payer taps Pay; nothing has been seen on chain yet.
  AWAITING_PAYMENT
  /// A transaction is attached (reported by the app or found by its memo) and waiting for confirmations.
  CONFIRMING
  CONFIRMED
  /// Never paid in time. A payment with its memo that lands later still attaches.
  EXPIRED
}

model OfframpOrder {
  id                    String                @id @default(uuid())
  reference             String                @unique
  /// app, voice, or api (made by a partner through /v1).
  source                String                @default("app")
  /// The wallet that started it in the app. Null for partner API orders, whose users may have no wallet of their own.
  userAddress           String?
  /// False for orders made with a partner's test key: simulated end to end, never on chain or at Paystack.
  livemode              Boolean               @default(true)
  partnerId             String?
  partner               Partner?              @relation(fields: [partnerId], references: [id])
  /// The partner's own id for this cash-out (not unique) and their key/value notes, both echoed back to them.
  partnerReference      String?
  metadata              Json?
  /// Where a refund goes instead of the deposit's sender. Deposits from exchanges and custodial wallets come from
  /// addresses that can't take a refund, so partners can name the right one.
  refundAddress         String?
  /// Sandbox only: the simulated bank transfer fails, so the order goes on to a refund.
  sandboxPayoutFails    Boolean               @default(false)
  nimLuna               BigInt
  rateNgnPerNim         Decimal               @db.Decimal(24, 8)
  grossKobo             BigInt
  feeKobo               BigInt
  payoutKobo            BigInt
  bankCode              String
  bankName              String
  accountNumber         String
  accountName           String
  status                OfframpStatus         @default(AWAITING_DEPOSIT)
  depositTxHash         String?               @unique
  depositSubmittedAt    DateTime?
  depositConfirmedAt    DateTime?
  depositFrom           String?
  receivedLuna          BigInt?
  paystackRecipientCode String?
  paystackTransferCode  String?
  paidAt                DateTime?
  refundTxHash          String?
  refundTxHex           String?
  refundSentAt          DateTime?
  failureReason         String?
  expiresAt             DateTime
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  ledger                LedgerEntry[]
  webhookEvents         PartnerWebhookEvent[]

  @@index([userAddress, createdAt])
  @@index([status])
  @@index([partnerId, livemode, createdAt])
}

/// A developer (wallet, exchange, mini app) using the off-ramp API at /v1. Managed in the admin dashboard.
model Partner {
  id                String                  @id @default(uuid())
  name              String
  contactEmail      String?
  /// Where offramp.* events are sent, per mode. Test-key orders only ever go to the test URL.
  webhookUrlTest    String?
  webhookUrlLive    String?
  /// HMAC-SHA256 signing secrets (whsec_…), per mode. Kept in full because every delivery is signed with them.
  webhookSecretTest String
  webhookSecretLive String
  /// A disabled partner's keys all stop working; its orders still finish.
  disabledAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  apiKeys           PartnerApiKey[]
  orders            OfframpOrder[]
  webhookEvents     PartnerWebhookEvent[]
  idempotencyKeys   PartnerIdempotencyKey[]
}

/// A secret key for /v1: kp_test_… or kp_live_…. Only its SHA-256 and a short prefix are stored; the full key is shown once.
model PartnerApiKey {
  id           String    @id @default(uuid())
  partnerId    String
  partner      Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  livemode     Boolean
  /// The key's first characters (e.g. kp_test_Ab3dE9xQ): shown in the dashboard and used to look the key up.
  prefix       String    @unique
  /// SHA-256 of the whole key, hex.
  keyHash      String
  label        String    @default("")
  lastUsedAt   DateTime?
  /// Set on rotation: the old key keeps working until then, so the partner can deploy the new one.
  expiresAt    DateTime?
  revokedAt    DateTime?
  /// The key that replaced this one when it was rotated.
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([partnerId])
}

enum WebhookEventStatus {
  /// Waiting for its next delivery attempt.
  PENDING
  DELIVERED
  /// Every retry failed.
  FAILED
  /// The partner had no webhook URL for this mode when it was due.
  SKIPPED
}

/// One event for a partner, written in the same transaction as the order change it reports (an outbox), then delivered.
model PartnerWebhookEvent {
  id            String                   @id @default(uuid())
  partnerId     String
  partner       Partner                  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  livemode      Boolean
  /// offramp.deposit_confirmed, offramp.paid, offramp.payout_failed, offramp.refunded, offramp.expired.
  type          String
  /// Null for test events sent from the dashboard or POST /v1/webhooks/test.
  orderId       String?
  order         OfframpOrder?            @relation(fields: [orderId], references: [id])
  /// The exact JSON body sent (and signed) on every attempt.
  payload       String
  status        WebhookEventStatus       @default(PENDING)
  attempts      Int                      @default(0)
  nextAttemptAt DateTime?                @default(now())
  deliveredAt   DateTime?
  lastError     String?
  createdAt     DateTime                 @default(now())
  deliveries    PartnerWebhookDelivery[]

  /// Each kind of event happens at most once per order.
  @@unique([orderId, type])
  @@index([status, nextAttemptAt])
  @@index([partnerId, livemode, createdAt])
}

/// One HTTP attempt at delivering a webhook event: the delivery log.
model PartnerWebhookDelivery {
  id           String              @id @default(uuid())
  eventId      String
  event        PartnerWebhookEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attempt      Int
  url          String
  statusCode   Int?
  /// Network error or timeout, when no HTTP response came back.
  error        String?
  /// The start of the response body, for debugging.
  responseBody String?
  durationMs   Int
  createdAt    DateTime            @default(now())

  @@index([eventId])
}

/// A POST to /v1 and its Idempotency-Key: the same key and request get the stored response instead of running twice.
model PartnerIdempotencyKey {
  id          String   @id @default(uuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  livemode    Boolean
  key         String
  /// SHA-256 of method, path and body. Reusing a key for a different request is refused.
  requestHash String
  /// Null while the first request is still running.
  statusCode  Int?
  response    String?
  createdAt   DateTime @default(now())

  @@unique([partnerId, livemode, key])
  @@index([createdAt])
}

model LedgerEntry {
  id            String        @id @default(uuid())
  orderId       String?
  order         OfframpOrder? @relation(fields: [orderId], references: [id])
  giftCardId    String?
  giftCard      GiftCard?     @relation(fields: [giftCardId], references: [id])
  revivalId     String?
  revival       PetRevival?   @relation(fields: [revivalId], references: [id])
  onrampOrderId String?
  onrampOrder   OnrampOrder?  @relation(fields: [onrampOrderId], references: [id])
  kind          LedgerKind
  asset         String
  amount        BigInt
  debit         String
  credit        String
  externalRef   String
  createdAt     DateTime      @default(now())

  @@unique([orderId, kind])
  @@unique([giftCardId, kind])
  @@unique([revivalId, kind])
  @@unique([onrampOrderId, kind])
}

/// A purchase of NIM with local currency through a Bachs checkout, paid out from the treasury.
model OnrampOrder {
  id                String       @id @default(uuid())
  reference         String       @unique
  /// The account connected in Nimiq Pay, as the buyer chose it.
  walletAddress     String
  /// Where the NIM actually goes: the wallet itself, or the owner of a Nimiq Pay HTLC wallet.
  payoutAddress     String
  fiatCurrency      String
  fiatAmount        Decimal      @db.Decimal(24, 4)
  /// Price of 1 NIM in fiatCurrency when the quote was locked.
  fiatPerNim        Decimal      @db.Decimal(24, 12)
  usdPerNim         Decimal      @db.Decimal(24, 12)
  feeBps            Int
  nimLuna           BigInt
  status            OnrampStatus @default(AWAITING_PAYMENT)
  checkoutId        String?      @unique
  checkoutUrl       String?
  checkoutExpiresAt DateTime
  chargeId          String?
  paidAmount        Decimal?     @db.Decimal(24, 4)
  paidAt            DateTime?
  payoutTxHash      String?      @unique
  payoutTxHex       String?
  payoutSentAt      DateTime?
  completedAt       DateTime?
  failureReason     String?
  /// Set when an operator settled a purchase held for review (sent the NIM or closed it as refunded).
  reviewedAt        DateTime?
  reviewNote        String?
  /// Who settled it: the admin's email for a dashboard session, "admin-token" for the static ADMIN_TOKEN.
  reviewedBy        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  ledger            LedgerEntry[]

  @@index([walletAddress, createdAt])
  @@index([status])
}

model GiftCard {
  id                 String         @id @default(uuid())
  reference          String         @unique
  /// Short code recipients can type into the app to open the gift, e.g. K7QM3XPD (shown as K7QM-3XPD).
  shareCode          String?        @unique
  amountLuna         BigInt
  /// Address holding this gift's NIM, the gift escrow (NIMIQ_GIFT_PRIVATE_KEY). Null on gifts made before gifts had
  /// their own escrow: those sit in the treasury and are paid from it.
  escrowAddress      String?
  message            String         @default("")
  redeemCodeHash     String
  /// SHA-256 of a random key handed to the creating device; lets that device take the gift back without signing.
  senderKeyHash      String?
  template           String         @default("default")
  senderAddress      String
  /// Shown to the recipient; null for anonymous gifts.
  senderName         String?
  recipientEmail     String?
  /// Set once Resend accepted the "you got a gift" email; it's sent after the gift is funded.
  emailSentAt        DateTime?
  emailAttempts      Int            @default(0)
  emailError         String?
  anonymous          Boolean        @default(false)
  status             GiftCardStatus @default(AWAITING_FUNDING)
  fundingTxHash      String?        @unique
  fundingSubmittedAt DateTime?
  fundedAt           DateTime?
  fundedFrom         String?
  receivedLuna       BigInt?
  claimerAddress     String?
  claimTxHash        String?        @unique
  claimTxHex         String?
  claimSentAt        DateTime?
  claimedAt          DateTime?
  /// Set when the sender took an unclaimed gift back; the refund leg then returns the NIM.
  reclaimedAt        DateTime?
  refundTxHash       String?
  refundTxHex        String?
  refundSentAt       DateTime?
  failureReason      String?
  expiresAt          DateTime
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  ledger             LedgerEntry[]

  @@index([senderAddress, createdAt])
  @@index([status])
}

/// A shop that accepts NIM by QR. Payments go straight to payoutAddress; KhalkosPay never holds them.
model Merchant {
  id            String            @id @default(uuid())
  /// Short code printed on the banner and carried by its QR link, e.g. K7QM3XPD (shown as K7QM-3XPD).
  code          String            @unique
  /// The wallet that signed in and owns this profile; one profile per wallet.
  ownerAddress  String            @unique
  /// Where payments go. A Nimiq Pay HTLC wallet is resolved to the basic account that owns it.
  payoutAddress String
  name          String
  category      String
  description   String            @default("")
  phone         String?
  location      String?
  /// Square logo as a data: URL, resized on the device before upload.
  logo          String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  payments      MerchantPayment[]

  @@index([payoutAddress])
}

/// One scan-to-pay payment. The memo (reference) lets the server find it on chain even if the app never reports it.
model MerchantPayment {
  id            String                @id @default(uuid())
  merchantId    String
  merchant      Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  reference     String                @unique
  /// The payout address when the payment was created, so a later profile edit never re-routes or orphans it.
  recipient     String
  amountLuna    BigInt
  note          String                @default("")
  /// The payer's account as the app reported it; the confirmed tx's sender is in paidFrom.
  payerAddress  String?
  status        MerchantPaymentStatus @default(AWAITING_PAYMENT)
  txHash        String?               @unique
  txSubmittedAt DateTime?
  paidFrom      String?
  receivedLuna  BigInt?
  confirmedAt   DateTime?
  failureReason String?
  expiresAt     DateTime
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([merchantId, createdAt])
  @@index([recipient, status])
  @@index([status])
}

model Pet {
  id            String       @id @default(uuid())
  ownerAddress  String       @unique
  species       String
  name          String
  timezone      String
  strength      Int          @default(70)
  xp            Int          @default(0)
  status        PetStatus    @default(ALIVE)
  /// Meal windows that opened before this moment never count as missed (adoption or last revive).
  aliveSince    DateTime     @default(now())
  /// Every meal window that closed before this moment has been scored.
  settledUntil  DateTime     @default(now())
  diedAt        DateTime?
  deathReason   String?
  lastStandUsed Boolean      @default(false)
  revivals      Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  meals         PetMeal[]
  revivalOrders PetRevival[]
}

model PetMeal {
  id            String   @id @default(uuid())
  petId         String
  pet           Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  /// Local calendar day in the pet's timezone, YYYY-MM-DD.
  day           String
  slot          MealSlot
  fed           Boolean
  name          String?
  score         Int?
  calories      Float?
  protein       Float?
  carbs         Float?
  fat           Float?
  fiber         Float?
  strengthDelta Int
  xpDelta       Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([petId, day, slot])
  @@index([petId, createdAt])
}

model PetRevival {
  id            String           @id @default(uuid())
  petId         String
  pet           Pet              @relation(fields: [petId], references: [id], onDelete: Cascade)
  reference     String           @unique
  priceLuna     BigInt
  status        PetRevivalStatus @default(AWAITING_PAYMENT)
  txHash        String?          @unique
  txSubmittedAt DateTime?
  paidAt        DateTime?
  payer         String?
  receivedLuna  BigInt?
  refundTxHash  String?
  refundTxHex   String?
  refundSentAt  DateTime?
  failureReason String?
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  ledger        LedgerEntry[]

  @@index([petId, createdAt])
  @@index([status])
}

model MealLog {
  id        String   @id @default(uuid())
  userId    String?
  mealType  String
  name      String
  score     Int
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  fiber     Float
  createdAt DateTime @default(now())
}

/// An operator who can sign in to the admin dashboard at /admin. Created or reset with `npm run admin:seed`.
model AdminUser {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String         @default("")
  /// scrypt, as "scrypt$N$r$p$salt$hash" with base64 salt and hash.
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

/// A dashboard sign-in. Only the SHA-256 of the bearer token is stored, so a database leak can't be replayed.
model AdminSession {
  id         String    @id @default(uuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  /// Set on sign-out, or when the seed resets the password.
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([adminId])
}
