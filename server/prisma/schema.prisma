generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OfframpStatus {
  AWAITING_DEPOSIT
  CONFIRMING
  PAYING_OUT
  COMPLETED
  PAYOUT_FAILED
  REFUNDING
  REFUNDED
  REJECTED
  EXPIRED
}

enum GiftCardStatus {
  AWAITING_FUNDING
  ACTIVE
  CLAIMING
  CLAIMED
  EXPIRED
  REFUNDING
  REFUNDED
}

enum PetStatus {
  ALIVE
  DEAD
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
}

enum PetRevivalStatus {
  AWAITING_PAYMENT
  PAID
  EXPIRED
  REFUNDING
  REFUNDED
}

enum LedgerKind {
  DEPOSIT
  PAYOUT
  REFUND
}

model OfframpOrder {
  id                    String        @id @default(uuid())
  reference             String        @unique
  source                String        @default("app")
  userAddress           String
  nimLuna               BigInt
  rateNgnPerNim         Decimal       @db.Decimal(24, 8)
  grossKobo             BigInt
  feeKobo               BigInt
  payoutKobo            BigInt
  bankCode              String
  bankName              String
  accountNumber         String
  accountName           String
  status                OfframpStatus @default(AWAITING_DEPOSIT)
  depositTxHash         String?       @unique
  depositSubmittedAt    DateTime?
  depositConfirmedAt    DateTime?
  depositFrom           String?
  receivedLuna          BigInt?
  paystackRecipientCode String?
  paystackTransferCode  String?
  paidAt                DateTime?
  refundTxHash          String?
  refundTxHex           String?
  refundSentAt          DateTime?
  failureReason         String?
  expiresAt             DateTime
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  ledger                LedgerEntry[]

  @@index([userAddress, createdAt])
  @@index([status])
}

model LedgerEntry {
  id          String        @id @default(uuid())
  orderId     String?
  order       OfframpOrder? @relation(fields: [orderId], references: [id])
  giftCardId  String?
  giftCard    GiftCard?     @relation(fields: [giftCardId], references: [id])
  revivalId   String?
  revival     PetRevival?   @relation(fields: [revivalId], references: [id])
  kind        LedgerKind
  asset       String
  amount      BigInt
  debit       String
  credit      String
  externalRef String
  createdAt   DateTime      @default(now())

  @@unique([orderId, kind])
  @@unique([giftCardId, kind])
  @@unique([revivalId, kind])
}

model GiftCard {
  id                 String         @id @default(uuid())
  reference          String         @unique
  /// Short code recipients can type into the app to open the gift, e.g. K7QM3XPD (shown as K7QM-3XPD).
  shareCode          String?        @unique
  amountLuna         BigInt
  message            String         @default("")
  redeemCodeHash     String
  template           String         @default("default")
  senderAddress      String
  recipientEmail     String?
  anonymous          Boolean        @default(false)
  status             GiftCardStatus @default(AWAITING_FUNDING)
  fundingTxHash      String?        @unique
  fundingSubmittedAt DateTime?
  fundedAt           DateTime?
  fundedFrom         String?
  receivedLuna       BigInt?
  claimerAddress     String?
  claimTxHash        String?        @unique
  claimTxHex         String?
  claimSentAt        DateTime?
  claimedAt          DateTime?
  /// Set when the sender took an unclaimed gift back; the refund leg then returns the NIM.
  reclaimedAt        DateTime?
  refundTxHash       String?
  refundTxHex        String?
  refundSentAt       DateTime?
  failureReason      String?
  expiresAt          DateTime
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  ledger             LedgerEntry[]

  @@index([senderAddress, createdAt])
  @@index([status])
}

model Pet {
  id            String       @id @default(uuid())
  ownerAddress  String       @unique
  species       String
  name          String
  timezone      String
  strength      Int          @default(70)
  xp            Int          @default(0)
  status        PetStatus    @default(ALIVE)
  /// Meal windows that opened before this moment never count as missed (adoption or last revive).
  aliveSince    DateTime     @default(now())
  /// Every meal window that closed before this moment has been scored.
  settledUntil  DateTime     @default(now())
  diedAt        DateTime?
  deathReason   String?
  lastStandUsed Boolean      @default(false)
  revivals      Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  meals         PetMeal[]
  revivalOrders PetRevival[]
}

model PetMeal {
  id            String   @id @default(uuid())
  petId         String
  pet           Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  /// Local calendar day in the pet's timezone, YYYY-MM-DD.
  day           String
  slot          MealSlot
  fed           Boolean
  name          String?
  score         Int?
  calories      Float?
  protein       Float?
  carbs         Float?
  fat           Float?
  fiber         Float?
  strengthDelta Int
  xpDelta       Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([petId, day, slot])
  @@index([petId, createdAt])
}

model PetRevival {
  id            String           @id @default(uuid())
  petId         String
  pet           Pet              @relation(fields: [petId], references: [id], onDelete: Cascade)
  reference     String           @unique
  priceLuna     BigInt
  status        PetRevivalStatus @default(AWAITING_PAYMENT)
  txHash        String?          @unique
  txSubmittedAt DateTime?
  paidAt        DateTime?
  payer         String?
  receivedLuna  BigInt?
  refundTxHash  String?
  refundTxHex   String?
  refundSentAt  DateTime?
  failureReason String?
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  ledger        LedgerEntry[]

  @@index([petId, createdAt])
  @@index([status])
}

model MealLog {
  id        String   @id @default(uuid())
  userId    String?
  mealType  String
  name      String
  score     Int
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  fiber     Float
  createdAt DateTime @default(now())
}
