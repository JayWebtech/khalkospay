generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OfframpStatus {
  AWAITING_DEPOSIT
  CONFIRMING
  PAYING_OUT
  COMPLETED
  PAYOUT_FAILED
  REFUNDING
  REFUNDED
  REJECTED
  EXPIRED
}

enum GiftCardStatus {
  AWAITING_FUNDING
  ACTIVE
  CLAIMING
  CLAIMED
  EXPIRED
  REFUNDING
  REFUNDED
}

enum PetStatus {
  ALIVE
  DEAD
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
}

enum PetRevivalStatus {
  AWAITING_PAYMENT
  PAID
  EXPIRED
  REFUNDING
  REFUNDED
}

enum OnrampStatus {
  AWAITING_PAYMENT
  PAID
  SENDING
  COMPLETED
  EXPIRED
  NEEDS_REVIEW
  /// An operator closed a held purchase after refunding the buyer outside KhalkosPay; no NIM is owed.
  RESOLVED
}

enum LedgerKind {
  DEPOSIT
  PAYOUT
  REFUND
}

model OfframpOrder {
  id                    String        @id @default(uuid())
  reference             String        @unique
  source                String        @default("app")
  userAddress           String
  nimLuna               BigInt
  rateNgnPerNim         Decimal       @db.Decimal(24, 8)
  grossKobo             BigInt
  feeKobo               BigInt
  payoutKobo            BigInt
  bankCode              String
  bankName              String
  accountNumber         String
  accountName           String
  status                OfframpStatus @default(AWAITING_DEPOSIT)
  depositTxHash         String?       @unique
  depositSubmittedAt    DateTime?
  depositConfirmedAt    DateTime?
  depositFrom           String?
  receivedLuna          BigInt?
  paystackRecipientCode String?
  paystackTransferCode  String?
  paidAt                DateTime?
  refundTxHash          String?
  refundTxHex           String?
  refundSentAt          DateTime?
  failureReason         String?
  expiresAt             DateTime
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  ledger                LedgerEntry[]

  @@index([userAddress, createdAt])
  @@index([status])
}

model LedgerEntry {
  id          String        @id @default(uuid())
  orderId     String?
  order       OfframpOrder? @relation(fields: [orderId], references: [id])
  giftCardId  String?
  giftCard    GiftCard?     @relation(fields: [giftCardId], references: [id])
  revivalId   String?
  revival     PetRevival?   @relation(fields: [revivalId], references: [id])
  onrampOrderId String?
  onrampOrder   OnrampOrder? @relation(fields: [onrampOrderId], references: [id])
  kind        LedgerKind
  asset       String
  amount      BigInt
  debit       String
  credit      String
  externalRef String
  createdAt   DateTime      @default(now())

  @@unique([orderId, kind])
  @@unique([giftCardId, kind])
  @@unique([revivalId, kind])
  @@unique([onrampOrderId, kind])
}

/// A purchase of NIM with local currency through a Bachs checkout, paid out from the treasury.
model OnrampOrder {
  id                String       @id @default(uuid())
  reference         String       @unique
  /// The account connected in Nimiq Pay, as the buyer chose it.
  walletAddress     String
  /// Where the NIM actually goes: the wallet itself, or the owner of a Nimiq Pay HTLC wallet.
  payoutAddress     String
  fiatCurrency      String
  fiatAmount        Decimal      @db.Decimal(24, 4)
  /// Price of 1 NIM in fiatCurrency when the quote was locked.
  fiatPerNim        Decimal      @db.Decimal(24, 12)
  usdPerNim         Decimal      @db.Decimal(24, 12)
  feeBps            Int
  nimLuna           BigInt
  status            OnrampStatus @default(AWAITING_PAYMENT)
  checkoutId        String?      @unique
  checkoutUrl       String?
  checkoutExpiresAt DateTime
  chargeId          String?
  paidAmount        Decimal?     @db.Decimal(24, 4)
  paidAt            DateTime?
  payoutTxHash      String?      @unique
  payoutTxHex       String?
  payoutSentAt      DateTime?
  completedAt       DateTime?
  failureReason     String?
  /// Set when an operator settled a purchase held for review (sent the NIM or closed it as refunded).
  reviewedAt        DateTime?
  reviewNote        String?
  /// Who settled it: the admin's email for a dashboard session, "admin-token" for the static ADMIN_TOKEN.
  reviewedBy        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  ledger            LedgerEntry[]

  @@index([walletAddress, createdAt])
  @@index([status])
}

model GiftCard {
  id                 String         @id @default(uuid())
  reference          String         @unique
  /// Short code recipients can type into the app to open the gift, e.g. K7QM3XPD (shown as K7QM-3XPD).
  shareCode          String?        @unique
  amountLuna         BigInt
  message            String         @default("")
  redeemCodeHash     String
  /// SHA-256 of a random key handed to the creating device; lets that device take the gift back without signing.
  senderKeyHash      String?
  template           String         @default("default")
  senderAddress      String
  /// Shown to the recipient; null for anonymous gifts.
  senderName         String?
  recipientEmail     String?
  /// Set once Resend accepted the "you got a gift" email; it's sent after the gift is funded.
  emailSentAt        DateTime?
  emailAttempts      Int            @default(0)
  emailError         String?
  anonymous          Boolean        @default(false)
  status             GiftCardStatus @default(AWAITING_FUNDING)
  fundingTxHash      String?        @unique
  fundingSubmittedAt DateTime?
  fundedAt           DateTime?
  fundedFrom         String?
  receivedLuna       BigInt?
  claimerAddress     String?
  claimTxHash        String?        @unique
  claimTxHex         String?
  claimSentAt        DateTime?
  claimedAt          DateTime?
  /// Set when the sender took an unclaimed gift back; the refund leg then returns the NIM.
  reclaimedAt        DateTime?
  refundTxHash       String?
  refundTxHex        String?
  refundSentAt       DateTime?
  failureReason      String?
  expiresAt          DateTime
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  ledger             LedgerEntry[]

  @@index([senderAddress, createdAt])
  @@index([status])
}

model Pet {
  id            String       @id @default(uuid())
  ownerAddress  String       @unique
  species       String
  name          String
  timezone      String
  strength      Int          @default(70)
  xp            Int          @default(0)
  status        PetStatus    @default(ALIVE)
  /// Meal windows that opened before this moment never count as missed (adoption or last revive).
  aliveSince    DateTime     @default(now())
  /// Every meal window that closed before this moment has been scored.
  settledUntil  DateTime     @default(now())
  diedAt        DateTime?
  deathReason   String?
  lastStandUsed Boolean      @default(false)
  revivals      Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  meals         PetMeal[]
  revivalOrders PetRevival[]
}

model PetMeal {
  id            String   @id @default(uuid())
  petId         String
  pet           Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  /// Local calendar day in the pet's timezone, YYYY-MM-DD.
  day           String
  slot          MealSlot
  fed           Boolean
  name          String?
  score         Int?
  calories      Float?
  protein       Float?
  carbs         Float?
  fat           Float?
  fiber         Float?
  strengthDelta Int
  xpDelta       Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([petId, day, slot])
  @@index([petId, createdAt])
}

model PetRevival {
  id            String           @id @default(uuid())
  petId         String
  pet           Pet              @relation(fields: [petId], references: [id], onDelete: Cascade)
  reference     String           @unique
  priceLuna     BigInt
  status        PetRevivalStatus @default(AWAITING_PAYMENT)
  txHash        String?          @unique
  txSubmittedAt DateTime?
  paidAt        DateTime?
  payer         String?
  receivedLuna  BigInt?
  refundTxHash  String?
  refundTxHex   String?
  refundSentAt  DateTime?
  failureReason String?
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  ledger        LedgerEntry[]

  @@index([petId, createdAt])
  @@index([status])
}

model MealLog {
  id        String   @id @default(uuid())
  userId    String?
  mealType  String
  name      String
  score     Int
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  fiber     Float
  createdAt DateTime @default(now())
}

/// An operator who can sign in to the admin dashboard at /admin. Created or reset with `npm run admin:seed`.
model AdminUser {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String         @default("")
  /// scrypt, as "scrypt$N$r$p$salt$hash" with base64 salt and hash.
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

/// A dashboard sign-in. Only the SHA-256 of the bearer token is stored, so a database leak can't be replayed.
model AdminSession {
  id         String    @id @default(uuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  /// Set on sign-out, or when the seed resets the password.
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([adminId])
}
