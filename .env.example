# Backend URL. Defaults to http://<current host>:3101, which also works when Nimiq Pay loads the app from your LAN IP.
VITE_API_URL=
# Public host of the mini app (no https://), e.g. khalkospay.app. Gift links become
# https://nimpay.app/miniapps/open/<host>/gift/<id> so they open inside Nimiq Pay. Defaults to the current host.
VITE_MINIAPP_URL=
